# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# Google Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=

# Gmail SMTP — use an App Password, not your normal login password.
# https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# OpenAI assistant
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional test delivery (no student records)
TEST_EMAIL_RECIPIENT=

# Local-only by default. See README before sharing.
AUTH_REQUIRED=false
ALLOWED_EMAILS=
